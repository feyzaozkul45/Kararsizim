# Copy this file to .env and fill in the values.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. In production use the Supabase
# connection pooler (Transaction mode, port 6543) URL.
DATABASE_URL=

# Required only if you run `manage.py seed_demo` (only works when DEBUG=True).
# Pick your own local value; it becomes the demo users' password.
DEMO_PASSWORD=
